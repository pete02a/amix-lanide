--- a/port/amix-compat.h
+++ b/port/amix-compat.h
@@ -44,3 +44,7 @@
 char *ptsname(int);
 
 #endif
+
+/* Isolated Stage6 SSH fix: libc grantpt wait is signal-interruptible. */
+int amix_grantpt(int);
+#define grantpt amix_grantpt
--- a/port/amix-grantpt.c
+++ b/port/amix-grantpt.c
@@ -0,0 +1,20 @@
+
+/* Keep the server SIGCHLD handler from interrupting libc's helper wait.
+ * Restore its original mask and errno on every path. Other EINTR sources
+ * get at most three attempts. The wrapper preserves libc ownership checks. */
+#undef grantpt
+#include <signal.h>
+#include <errno.h>
+extern int grantpt(int);
+int amix_grantpt(int fd) {
+    sigset_t blocked, saved;
+    int rc, saved_errno, tries=0;
+    sigemptyset(&blocked);
+    sigaddset(&blocked,SIGCHLD);
+    if(sigprocmask(SIG_BLOCK,&blocked,&saved)<0)return -1;
+    do { rc=grantpt(fd); } while(rc<0 && errno==EINTR && ++tries<3);
+    saved_errno=errno;
+    if(sigprocmask(SIG_SETMASK,&saved,0)<0)return -1;
+    errno=saved_errno;
+    return rc;
+}
